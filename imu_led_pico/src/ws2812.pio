;
; WS2812B driver, after the Raspberry Pi pico-examples (BSD-3-Clause). One 24-bit
; word per LED, green first, shifted out most significant bit first at 800 kHz:
; every bit lasts T1 + T2 + T3 cycles of the state machine's clock.
;

.program ws2812
.side_set 1

; A 0 is high for T1 and a 1 for T1 + T2: 375 ns and 750 ns at 8 MHz, inside both
; the older WS2812B's 400 +- 150 ns and the newer one's 220 to 380 ns.
.define public T1 3
.define public T2 3
.define public T3 4

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
    jmp bitloop    side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap
