// What crosses the USB link: addresses, ports and who opens what.
digraph network {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=13, nodesep=0.5, ranksep=1.3, newrank=true, pad=0.2];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#7a7a7a", fillcolor="#f2f2f2", margin="0.15,0.07", width=2.8];
  edge [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=10, dir=both];

  subgraph cluster_board {
    label="Board, 192.168.7.1"; labeljust=l; style="rounded"; color="#c41f4c"; fontcolor="#c41f4c"; penwidth=1.5;
    zenoh_client [label="zenoh-pico session, client mode\nconnects to tcp/192.168.7.2:7447\nlease 60 s, keepalive every 5 s"];
    sntp [label="SNTP client\nevery 15 s, round trip compensated"];
    dhcp_server [label="DHCP server\nleases 192.168.7.2/24\nno gateway, no DNS"];
  }

  subgraph cluster_host {
    label="Host, 192.168.7.2"; labeljust=l; style="rounded"; color="#4762a6"; fontcolor="#4762a6"; penwidth=1.5;
    zenohd [label="rmw_zenohd\nlistens on tcp/7447\ndefault configuration", fillcolor="#e8edf8", color="#4762a6"];
    chrony [label="chrony, udp/123\nallow 192.168.7.0/24\nlocal stratum 10"];
    dhcp_client [label="DHCP client\ndefault profile"];
    ros_nodes [label="ROS 2 nodes\nrmw_zenoh_cpp, peer mode", fillcolor="#e8edf8", color="#4762a6"];
  }

  zenoh_client -> zenohd [label="TCP, opened by the board:\nall its ROS traffic"];
  sntp -> chrony [label="UDP"];
  dhcp_server -> dhcp_client [label="DHCP"];
  zenohd -> ros_nodes [label="discovery;\nthen peer to peer\nbetween host nodes"];

  {rank=same; zenoh_client; sntp; dhcp_server}
  {rank=same; zenohd; chrony; dhcp_client}
  dhcp_server -> sntp -> zenoh_client [style=invis];
  dhcp_client -> chrony -> zenohd [style=invis];
}
