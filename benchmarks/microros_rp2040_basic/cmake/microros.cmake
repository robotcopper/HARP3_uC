# libmicroros.a and its headers, built at build time by colcon over the mcu_ws
# of a micro_ros_setup generate_lib workspace, as build_firmware.sh would, with
# this firmware's compiler and code generation flags. zenoh-pico's rpi_pico
# layer compiles against the platform's FreeRTOS, lwIP and Pico SDK headers,
# read from the platform targets: include it after platform.cmake.
#
# Defines:
#   microros                          interface library to link the firmware to
#   MICROROS_POSIX_CLOCK_DEFINITIONS  what newlib needs to declare
#                                     clock_gettime(), which the firmware defines

if(NOT EXISTS "${MICROROS_FIRMWARE_DIR}/mcu_ws/colcon.meta")
  message(FATAL_ERROR "No generate_lib workspace in MICROROS_FIRMWARE_DIR (${MICROROS_FIRMWARE_DIR}): "
    "run create_microros_ws.sh.")
endif()

set(microros_dir "${CMAKE_BINARY_DIR}/microros")
set(microros_lib "${microros_dir}/libmicroros.a")
set(microros_include_dir "${microros_dir}/include")

# rcutils and rmw_zenoh_pico read the clocks with clock_gettime(), which newlib
# declares only for a POSIX timers platform.
set(MICROROS_POSIX_CLOCK_DEFINITIONS _POSIX_TIMERS=1 _POSIX_MONOTONIC_CLOCK=200112L)

# Never built: its include directories and definitions are those zenoh-pico
# links privately in picoros_usb_eth_init().
file(CONFIGURE OUTPUT "${microros_dir}/platform_probe.c" CONTENT "")
add_library(microros_platform_probe STATIC EXCLUDE_FROM_ALL "${microros_dir}/platform_probe.c")
target_link_libraries(microros_platform_probe PRIVATE ${PICOROS_USB_ETH_ZENOH_DEPS})

# A GCC response file. The platform headers come after every other include
# directory, as system headers, so that FreeRTOS's list.h or task.h shadow no
# package header. Definitions with quotes, such as PICO_BOARD="pico", are left
# out: a response file would strip the quotes, and no header needs them.
set(probe_includes "$<REMOVE_DUPLICATES:$<TARGET_PROPERTY:microros_platform_probe,INCLUDE_DIRECTORIES>>")
set(probe_definitions "$<LIST:FILTER,$<TARGET_PROPERTY:microros_platform_probe,COMPILE_DEFINITIONS>,EXCLUDE,\">")
file(GENERATE OUTPUT "${microros_dir}/platform_flags.rsp" CONTENT
"$<JOIN:$<LIST:TRANSFORM,${probe_includes},PREPEND,-idirafter >,\n>
$<JOIN:$<LIST:TRANSFORM,${probe_definitions},PREPEND,-D>,\n>
")

list(TRANSFORM MICROROS_POSIX_CLOCK_DEFINITIONS PREPEND "-D" OUTPUT_VARIABLE clock_flags)
list(JOIN clock_flags " " clock_flags)
set(microros_c_flags "${CMAKE_C_FLAGS} -ffunction-sections -fdata-sections ${clock_flags} @${microros_dir}/platform_flags.rsp")
set(microros_cxx_flags "${CMAKE_CXX_FLAGS} -ffunction-sections -fdata-sections -fno-rtti -fno-exceptions ${clock_flags} @${microros_dir}/platform_flags.rsp")
file(CONFIGURE OUTPUT "${microros_dir}/toolchain.cmake" @ONLY CONTENT [=[
# Generated by microros.cmake from the firmware's configuration.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR cortex-m0plus)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_C_COMPILER "@CMAKE_C_COMPILER@")
set(CMAKE_CXX_COMPILER "@CMAKE_CXX_COMPILER@")
set(CMAKE_AR "@CMAKE_AR@" CACHE FILEPATH "")
set(CMAKE_RANLIB "@CMAKE_RANLIB@" CACHE FILEPATH "")

set(CMAKE_C_FLAGS_INIT "@microros_c_flags@")
set(CMAKE_CXX_FLAGS_INIT "@microros_cxx_flags@")
set(CMAKE_C_FLAGS_RELEASE_INIT "@CMAKE_C_FLAGS_RELEASE@")
set(CMAKE_CXX_FLAGS_RELEASE_INIT "@CMAKE_CXX_FLAGS_RELEASE@")
]=])

# Added to mcu_ws/colcon.meta, whose values stay. zenoh-pico gets the options
# that picoros_usb_eth_init() forces, rmw_zenoh_pico the router at the host
# end of the USB link.
set(zenohpico_args
  -DZP_PLATFORM=rpi_pico
  -DBUILD_EXAMPLES=OFF
  -DBUILD_TOOLS=OFF
  -DBUILD_TESTING=OFF
  -DZ_FEATURE_LINK_TCP=1
  -DZ_FEATURE_LINK_UDP_MULTICAST=0
  -DZ_FEATURE_LINK_UDP_UNICAST=0
  -DZ_FEATURE_SCOUTING=0
  -DZ_FEATURE_LINK_SERIAL=0
  -DZ_FEATURE_LINK_SERIAL_USB=0
  -DZ_FEATURE_PUBLICATION=1
  -DZ_FEATURE_SUBSCRIPTION=1
  -DZ_FEATURE_QUERYABLE=1
  -DZ_FEATURE_QUERY=1
  -DZ_FEATURE_MULTI_THREAD=1
  -DZ_FEATURE_LIVELINESS=1
  -DZ_FEATURE_UNSTABLE_API=1
  -DZ_FEATURE_ADVANCED_PUBLICATION=1
  -DZ_FEATURE_AUTO_RECONNECT=0
  -DZ_TRANSPORT_LEASE=60000
  -DZ_TRANSPORT_LEASE_EXPIRE_FACTOR=12
  -DZ_FEATURE_RX_CACHE=1
)
set(rmw_zenoh_pico_args
  -DWITH_RPI_PICO=ON
  -DBUILD_DEMO=OFF
  -DRMW_ZENOH_PICO_TRANSPORT_TYPE=unicast
  -DRMW_ZENOH_PICO_CONNECT=${USB_NET_HOST_IP}
  -DRMW_ZENOH_PICO_CONNECT_PORT=7447
)
list(JOIN zenohpico_args "\", \"" zenohpico_json)
list(JOIN rmw_zenoh_pico_args "\", \"" rmw_zenoh_pico_json)
file(CONFIGURE OUTPUT "${microros_dir}/colcon.meta" @ONLY CONTENT [=[
{
    "names": {
        "zenohpico": {
            "cmake-args": ["@zenohpico_json@"]
        },
        "rmw_zenoh_pico": {
            "cmake-args": ["@rmw_zenoh_pico_json@"]
        }
    }
}
]=])

include(ExternalProject)
# colcon decides what to rebuild, so it runs on every build.
ExternalProject_Add(microros_build
  SOURCE_DIR "${MICROROS_FIRMWARE_DIR}/mcu_ws"
  BINARY_DIR "${microros_dir}"
  DOWNLOAD_COMMAND ""
  UPDATE_COMMAND ""
  CONFIGURE_COMMAND ""
  BUILD_COMMAND "${CMAKE_CURRENT_LIST_DIR}/build_microros.sh"
    "${MICROROS_FIRMWARE_DIR}" "${microros_dir}" "${CMAKE_AR}" "${CMAKE_RANLIB}" ${MICROROS_EXTRA_PACKAGES}
  INSTALL_COMMAND ""
  BUILD_ALWAYS ON
  BUILD_BYPRODUCTS "${microros_lib}"
  USES_TERMINAL_BUILD ON
)

file(MAKE_DIRECTORY "${microros_include_dir}")
add_library(microros INTERFACE)
target_include_directories(microros INTERFACE "${microros_include_dir}")
target_link_libraries(microros INTERFACE "${microros_lib}")
add_dependencies(microros microros_build)
